# Copy to terraform.tfvars (gitignored). No secrets belong in this file -
# an SSH PUBLIC key is not sensitive, but IS environment-specific, so it
# is kept out of committed files the same way as other generated values.

# Your own outbound IP, as a /32, or a small known CIDR. Never "*" or
# "0.0.0.0/0" - the variable's validation block rejects those.
ssh_source_address_prefix = "203.0.113.4/32"

# Your own SSH public key (the matching private key stays on your machine
# only - never paste a private key anywhere in this repository).
ci_ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"
